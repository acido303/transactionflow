# =============================================================================
# TransactionFlow — single source of truth for all configuration
# =============================================================================

# ─── Host-exposed ports ───────────────────────────────────────────────────────
FRONTEND_PORT=3000
PRODUCER_PORT=8081
REPORTING_PORT=8082
KAFKA_UI_PORT=8085
ADMINER_PORT=8086
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_RPC_PORT=7077
KAFKA_PORT=9092
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_NAMENODE_RPC_PORT=9000
POSTGRES_PORT=5432

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=transactionflow
POSTGRES_USER=transactionflow
POSTGRES_PASSWORD=transactionflow

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_CFG_AUTO_CREATE_TOPICS_ENABLE=false
# Note: above key maps to KAFKA_AUTO_CREATE_TOPICS_ENABLE in the apache/kafka image
KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_VALIDATED=transactions.validated
KAFKA_TOPIC_REJECTED=transactions.rejected
KAFKA_UI_CLUSTER_NAME=transactionflow-local

# ─── HDFS ─────────────────────────────────────────────────────────────────────
HDFS_CLUSTER_NAME=transactionflow
HDFS_REPLICATION=1
HDFS_PERMISSIONS_ENABLED=false
HDFS_RAW_PATH=hdfs://hdfs-namenode:9000/data/transactionflow/raw/transactions
HDFS_REJECTED_PATH=hdfs://hdfs-namenode:9000/data/transactionflow/rejected/transactions
HDFS_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/data/transactionflow/checkpoints

# ─── Spark ────────────────────────────────────────────────────────────────────
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ─── Internal Docker-network service URLs ────────────────────────────────────
# These are used by services talking to each other inside the Docker network.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
HDFS_DEFAULT_FS=hdfs://hdfs-namenode:9000
SPARK_MASTER_URL=spark://spark-master:7077
PRODUCER_SERVICE_URL=http://producer-service:8081
REPORTING_API_INTERNAL_URL=http://reporting-service:8082
HDFS_NAMENODE_HTTP_URL=http://hdfs-namenode:9870

# ─── Application ──────────────────────────────────────────────────────────────
HIGH_VALUE_THRESHOLD=10000
# Browser-facing URL — must be reachable from the user's machine
NEXT_PUBLIC_REPORTING_API_URL=http://localhost:8082
